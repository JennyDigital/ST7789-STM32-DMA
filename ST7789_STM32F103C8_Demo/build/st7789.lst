 157:../ST7789/st7789.c **** /**
 158:../ST7789/st7789.c ****  * @brief Initialize ST7789 controller
 159:../ST7789/st7789.c ****  * @param none
 160:../ST7789/st7789.c ****  * @return none
 161:../ST7789/st7789.c ****  */
 162:../ST7789/st7789.c **** void ST7789_Init(void)
 163:../ST7789/st7789.c **** {
 164:../ST7789/st7789.c **** 	#if ST7789_USE_DMA
 165:../ST7789/st7789.c **** 		memset(disp_buf, 0, sizeof(disp_buf));
 166:../ST7789/st7789.c **** 	#endif
 167:../ST7789/st7789.c **** 	ST7789_DELAY(10);
 168:../ST7789/st7789.c ****     ST7789_RST_Clr();
 169:../ST7789/st7789.c ****     ST7789_DELAY(10);
 170:../ST7789/st7789.c ****     ST7789_RST_Set();
 171:../ST7789/st7789.c ****     ST7789_DELAY(20);
 172:../ST7789/st7789.c **** 
 173:../ST7789/st7789.c ****     ST7789_WriteCommand(ST7789_COLMOD);		//	Set color mode
 174:../ST7789/st7789.c ****     ST7789_WriteSmallData(ST7789_COLOR_MODE_16bit);
 175:../ST7789/st7789.c ****   	ST7789_WriteCommand(0xB2);				//	Porch control
 176:../ST7789/st7789.c **** 	{
 177:../ST7789/st7789.c **** 		uint8_t data[] = {0x0C, 0x0C, 0x00, 0x33, 0x33};
 178:../ST7789/st7789.c **** 		ST7789_WriteData(data, sizeof(data));
 179:../ST7789/st7789.c **** 	}
 180:../ST7789/st7789.c **** 	ST7789_SetRotation(ST7789_ROTATION);	//	MADCTL (Display Rotation)
 181:../ST7789/st7789.c **** 	
 182:../ST7789/st7789.c **** 	/* Internal LCD Voltage generator settings */
 183:../ST7789/st7789.c ****     ST7789_WriteCommand(0XB7);				//	Gate Control
 184:../ST7789/st7789.c ****     ST7789_WriteSmallData(0x35);			//	Default value
 185:../ST7789/st7789.c ****     ST7789_WriteCommand(0xBB);				//	VCOM setting
 186:../ST7789/st7789.c ****     ST7789_WriteSmallData(0x19);			//	0.725v (default 0.75v for 0x20)
 187:../ST7789/st7789.c ****     ST7789_WriteCommand(0xC0);				//	LCMCTRL	
 188:../ST7789/st7789.c ****     ST7789_WriteSmallData (0x2C);			//	Default value
 189:../ST7789/st7789.c ****     ST7789_WriteCommand (0xC2);				//	VDV and VRH command Enable
 190:../ST7789/st7789.c ****     ST7789_WriteSmallData (0x01);			//	Default value
 191:../ST7789/st7789.c ****     ST7789_WriteCommand (0xC3);				//	VRH set
 192:../ST7789/st7789.c ****     ST7789_WriteSmallData (0x12);			//	+-4.45v (defalut +-4.1v for 0x0B)
 193:../ST7789/st7789.c ****     ST7789_WriteCommand (0xC4);				//	VDV set
 194:../ST7789/st7789.c ****     ST7789_WriteSmallData (0x20);			//	Default value
 195:../ST7789/st7789.c ****     ST7789_WriteCommand (0xC6);				//	Frame rate control in normal mode
 196:../ST7789/st7789.c ****     ST7789_WriteSmallData (0x0F);			//	Default value (60HZ)
 197:../ST7789/st7789.c ****     ST7789_WriteCommand (0xD0);				//	Power control
 198:../ST7789/st7789.c ****     ST7789_WriteSmallData (0xA4);			//	Default value
 199:../ST7789/st7789.c ****     ST7789_WriteSmallData (0xA1);			//	Default value
 200:../ST7789/st7789.c **** 	/**************** Division line ****************/
 201:../ST7789/st7789.c **** 
 202:../ST7789/st7789.c **** 	ST7789_WriteCommand(0xE0);
 203:../ST7789/st7789.c **** 	{
ARM GAS  /tmp/ccvpQaby.s 			page 5


 204:../ST7789/st7789.c **** 		uint8_t data[] = {0xD0, 0x04, 0x0D, 0x11, 0x13, 0x2B, 0x3F, 0x54, 0x4C, 0x18, 0x0D, 0x0B, 0x1F, 0
 205:../ST7789/st7789.c **** 		ST7789_WriteData(data, sizeof(data));
 206:../ST7789/st7789.c **** 	}
 207:../ST7789/st7789.c **** 
 208:../ST7789/st7789.c ****     ST7789_WriteCommand(0xE1);
 209:../ST7789/st7789.c **** 	{
 210:../ST7789/st7789.c **** 		uint8_t data[] = {0xD0, 0x04, 0x0C, 0x11, 0x13, 0x2C, 0x3F, 0x44, 0x51, 0x2F, 0x1F, 0x1F, 0x20, 0
 211:../ST7789/st7789.c **** 		ST7789_WriteData(data, sizeof(data));
 212:../ST7789/st7789.c **** 	}
 213:../ST7789/st7789.c ****     ST7789_WriteCommand (ST7789_INVON);		//	Inversion ON
 214:../ST7789/st7789.c **** 	ST7789_WriteCommand (ST7789_SLPOUT);	//	Out of sleep mode
 215:../ST7789/st7789.c ****   	ST7789_WriteCommand (ST7789_NORON);		//	Normal Display on
 216:../ST7789/st7789.c ****   	ST7789_WriteCommand (ST7789_DISPON);	//	Main screen turned on	
 217:../ST7789/st7789.c **** 
