 225:../ST7789/st7789.c **** /**
 226:../ST7789/st7789.c ****  * @brief Fill the DisplayWindow with single color
 227:../ST7789/st7789.c ****  * @param color -> color to Fill with
 228:../ST7789/st7789.c ****  * @return none
 229:../ST7789/st7789.c ****  */
 230:../ST7789/st7789.c **** void ST7789_Fill_Color(uint16_t color) {
 231:../ST7789/st7789.c ****     uint16_t i;
 232:../ST7789/st7789.c ****     ST7789_SetAddressWindow(0, 0, ST7789_WIDTH - 1, ST7789_HEIGHT - 1);
 233:../ST7789/st7789.c ****     ST7789_Select();
 234:../ST7789/st7789.c **** 
 235:../ST7789/st7789.c **** 	#if ST7789_USE_DMA
 236:../ST7789/st7789.c **** 
 237:../ST7789/st7789.c ****     for (i = 0; i < (ST7789_HEIGHT * ST7789_WIDTH) / (sizeof(disp_buf) / 2); i++) {
 238:../ST7789/st7789.c ****         memset_16((uint16_t*)disp_buf, color, sizeof(disp_buf) / 2); 
 239:../ST7789/st7789.c ****         SendBuffer((uint16_t*)disp_buf, sizeof(disp_buf) / 2);     
 240:../ST7789/st7789.c ****     }
 241:../ST7789/st7789.c ****     #else
 242:../ST7789/st7789.c ****     uint16_t j;
 243:../ST7789/st7789.c ****     for (i = 0; i < ST7789_HEIGHT; i++) {
 244:../ST7789/st7789.c ****         for (j = 0; j < ST7789_WIDTH; j++) {
 245:../ST7789/st7789.c ****             uint8_t data[] = {color >> 8, color & 0xFF}; 
 246:../ST7789/st7789.c ****             ST7789_WriteData(data, sizeof(data));
 247:../ST7789/st7789.c ****         }
 248:../ST7789/st7789.c ****     }
 249:../ST7789/st7789.c ****     #endif
 250:../ST7789/st7789.c **** 
 251:../ST7789/st7789.c ****     ST7789_UnSelect();
 252:../ST7789/st7789.c **** }
 253:../ST7789/st7789.c **** 
 254:../ST7789/st7789.c **** /**
 255:../ST7789/st7789.c ****  * @brief Draw a Pixel
 256:../ST7789/st7789.c ****  * @param x&y -> coordinate to Draw
 257:../ST7789/st7789.c ****  * @param color -> color of the Pixel
 258:../ST7789/st7789.c ****  * @return none
 259:../ST7789/st7789.c ****  */
 260:../ST7789/st7789.c **** void ST7789_DrawPixel(uint16_t x, uint16_t y, uint16_t color)
ARM GAS  /tmp/ccvpQaby.s 			page 6


 261:../ST7789/st7789.c **** {
 262:../ST7789/st7789.c **** 	if ((x < 0) || (x >= ST7789_WIDTH) ||
 263:../ST7789/st7789.c **** 		 (y < 0) || (y >= ST7789_HEIGHT))	return;
 264:../ST7789/st7789.c **** 	
 265:../ST7789/st7789.c **** 	ST7789_SetAddressWindow(x, y, x, y);
 266:../ST7789/st7789.c **** 	uint8_t data[] = {color >> 8, color & 0xFF};
 267:../ST7789/st7789.c **** 	ST7789_Select();
 268:../ST7789/st7789.c **** 	ST7789_WriteData(data, sizeof(data));
 269:../ST7789/st7789.c **** 	ST7789_UnSelect();
 270:../ST7789/st7789.c **** }
 271:../ST7789/st7789.c **** 
 272:../ST7789/st7789.c **** /**
 273:../ST7789/st7789.c ****  * @brief Fill an Area with single color
 274:../ST7789/st7789.c ****  * @param xSta&ySta -> coordinate of the start point
 275:../ST7789/st7789.c ****  * @param xEnd&yEnd -> coordinate of the end point
 276:../ST7789/st7789.c ****  * @param color -> color to Fill with
 277:../ST7789/st7789.c ****  * @return none
 278:../ST7789/st7789.c ****  */
 279:../ST7789/st7789.c **** void ST7789_Fill(uint16_t xSta, uint16_t ySta, uint16_t xEnd, uint16_t yEnd, uint16_t color)
 280:../ST7789/st7789.c **** {
 281:../ST7789/st7789.c **** 	if ((xEnd < 0) || (xEnd >= ST7789_WIDTH) ||
 282:../ST7789/st7789.c **** 		 (yEnd < 0) || (yEnd >= ST7789_HEIGHT))	return;
 283:../ST7789/st7789.c **** 	ST7789_Select();
 284:../ST7789/st7789.c **** 	uint16_t i, j;
 285:../ST7789/st7789.c **** 	ST7789_SetAddressWindow(xSta, ySta, xEnd, yEnd);
 286:../ST7789/st7789.c **** 	for (i = ySta; i <= yEnd; i++)
 287:../ST7789/st7789.c **** 		for (j = xSta; j <= xEnd; j++) {
 288:../ST7789/st7789.c **** 			uint8_t data[] = {color >> 8, color & 0xFF};
 289:../ST7789/st7789.c **** 			ST7789_WriteData(data, sizeof(data));
 290:../ST7789/st7789.c **** 		}
 291:../ST7789/st7789.c **** 	ST7789_UnSelect();
 292:../ST7789/st7789.c **** }
