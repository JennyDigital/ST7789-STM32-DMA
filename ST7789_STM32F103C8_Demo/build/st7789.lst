 102:../ST7789/st7789.c **** /**
 103:../ST7789/st7789.c ****  * @brief Set the rotation direction of the display
 104:../ST7789/st7789.c ****  * @param m -> rotation parameter(please refer it in st7789.h)
 105:../ST7789/st7789.c ****  * @return none
 106:../ST7789/st7789.c ****  */
 107:../ST7789/st7789.c **** void ST7789_SetRotation(uint8_t m)
 108:../ST7789/st7789.c **** {
 109:../ST7789/st7789.c **** 	ST7789_WriteCommand(ST7789_MADCTL);	// MADCTL
 110:../ST7789/st7789.c **** 	switch (m) {
 111:../ST7789/st7789.c **** 	case 0:
 112:../ST7789/st7789.c **** 		ST7789_WriteSmallData(ST7789_MADCTL_MX | ST7789_MADCTL_MY | ST7789_MADCTL_RGB);
 113:../ST7789/st7789.c **** 		break;
 114:../ST7789/st7789.c **** 	case 1:
 115:../ST7789/st7789.c **** 		ST7789_WriteSmallData(ST7789_MADCTL_MY | ST7789_MADCTL_MV | ST7789_MADCTL_RGB);
 116:../ST7789/st7789.c **** 		break;
 117:../ST7789/st7789.c **** 	case 2:
 118:../ST7789/st7789.c **** 		ST7789_WriteSmallData(ST7789_MADCTL_RGB);
 119:../ST7789/st7789.c **** 		break;
 120:../ST7789/st7789.c **** 	case 3:
 121:../ST7789/st7789.c **** 		ST7789_WriteSmallData(ST7789_MADCTL_MX | ST7789_MADCTL_MV | ST7789_MADCTL_RGB);
 122:../ST7789/st7789.c **** 		break;
 123:../ST7789/st7789.c **** 	default:
 124:../ST7789/st7789.c **** 		break;
 125:../ST7789/st7789.c **** 	}
 126:../ST7789/st7789.c **** }
 127:../ST7789/st7789.c **** 
 128:../ST7789/st7789.c **** /**
 129:../ST7789/st7789.c ****  * @brief Set address of DisplayWindow
 130:../ST7789/st7789.c ****  * @param xi&yi -> coordinates of window
 131:../ST7789/st7789.c ****  * @return none
 132:../ST7789/st7789.c ****  */
 133:../ST7789/st7789.c **** static void ST7789_SetAddressWindow(uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1)
 134:../ST7789/st7789.c **** {
 135:../ST7789/st7789.c **** 	ST7789_Select();
 136:../ST7789/st7789.c **** 	uint16_t x_start = x0 + X_SHIFT, x_end = x1 + X_SHIFT;
 137:../ST7789/st7789.c **** 	uint16_t y_start = y0 + Y_SHIFT, y_end = y1 + Y_SHIFT;
 138:../ST7789/st7789.c **** 	
 139:../ST7789/st7789.c **** 	/* Column Address set */
 140:../ST7789/st7789.c **** 	ST7789_WriteCommand(ST7789_CASET); 
 141:../ST7789/st7789.c **** 	{
 142:../ST7789/st7789.c **** 		uint8_t data[] = {x_start >> 8, x_start & 0xFF, x_end >> 8, x_end & 0xFF};
 143:../ST7789/st7789.c **** 		ST7789_WriteData(data, sizeof(data));
 144:../ST7789/st7789.c **** 	}
 145:../ST7789/st7789.c **** 
 146:../ST7789/st7789.c **** 	/* Row Address set */
ARM GAS  /tmp/ccvpQaby.s 			page 4


 147:../ST7789/st7789.c **** 	ST7789_WriteCommand(ST7789_RASET);
 148:../ST7789/st7789.c **** 	{
 149:../ST7789/st7789.c **** 		uint8_t data[] = {y_start >> 8, y_start & 0xFF, y_end >> 8, y_end & 0xFF};
 150:../ST7789/st7789.c **** 		ST7789_WriteData(data, sizeof(data));
 151:../ST7789/st7789.c **** 	}
 152:../ST7789/st7789.c **** 	/* Write to RAM */
 153:../ST7789/st7789.c **** 	ST7789_WriteCommand(ST7789_RAMWR);
 154:../ST7789/st7789.c **** 	ST7789_UnSelect();
 155:../ST7789/st7789.c **** }
