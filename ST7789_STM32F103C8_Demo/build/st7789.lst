  12:../ST7789/st7789.c **** #if ST7789_USE_DMA
  13:../ST7789/st7789.c **** #include <string.h>
  14:../ST7789/st7789.c **** uint16_t DMA_MIN_SIZE = 16;
  15:../ST7789/st7789.c **** /* If you're using DMA, then u need a "framebuffer" to store datas to be displayed.
  16:../ST7789/st7789.c ****  * If your MCU don't have enough RAM, please avoid using DMA(or set 5 to 1).
  17:../ST7789/st7789.c ****  * And if your MCU have enough RAM(even larger than full-frame size),
  18:../ST7789/st7789.c ****  * Then you can specify the framebuffer size to the full resolution below.
  19:../ST7789/st7789.c ****  */
  20:../ST7789/st7789.c ****  #define HOR_LEN 	5	//	Also mind the resolution of your screen!
  21:../ST7789/st7789.c **** uint16_t disp_buf[ST7789_WIDTH * HOR_LEN];
  22:../ST7789/st7789.c **** #endif
  23:../ST7789/st7789.c **** 
  24:../ST7789/st7789.c **** void memset_16(uint16_t* buf, uint16_t value, uint32_t size) 
  25:../ST7789/st7789.c **** {
  26:../ST7789/st7789.c ****     uint16_t swapped = (value >> 8) | (value << 8); 
  27:../ST7789/st7789.c ****     while (size > 0) {
  28:../ST7789/st7789.c ****         *buf = swapped; 
  29:../ST7789/st7789.c ****         buf++;
  30:../ST7789/st7789.c ****         size--;
  31:../ST7789/st7789.c ****     }
  32:../ST7789/st7789.c **** }
