 803:../ST7789/st7789.c **** /**
 804:../ST7789/st7789.c ****  * @brief Draw a fast vertical line using DMA
 805:../ST7789/st7789.c ****  * @param x -> X-coordinate of the starting point
 806:../ST7789/st7789.c ****  * @param y -> Y-coordinate of the line
 807:../ST7789/st7789.c ****  * @param w -> Width of the line
 808:../ST7789/st7789.c ****  * @param color -> Color of the line
 809:../ST7789/st7789.c ****  * @return none
 810:../ST7789/st7789.c ****  */
 811:../ST7789/st7789.c **** void ST7789_DrawFastVLine(uint16_t x, uint16_t y, uint16_t h, uint16_t color) 
 812:../ST7789/st7789.c **** {
 813:../ST7789/st7789.c ****     if ((x >= ST7789_WIDTH) || (y >= ST7789_HEIGHT)) return;
 814:../ST7789/st7789.c **** 
 815:../ST7789/st7789.c ****     uint16_t adjusted_height = (y + h > ST7789_HEIGHT) ? (ST7789_HEIGHT - y) : h;
 816:../ST7789/st7789.c **** 
 817:../ST7789/st7789.c ****     ST7789_SetAddressWindow(x, y, x, y + adjusted_height - 1);
 818:../ST7789/st7789.c **** 
 819:../ST7789/st7789.c **** #if ST7789_USE_DMA
 820:../ST7789/st7789.c ****     memset_16((uint16_t*)disp_buf, color, sizeof(disp_buf) / 2); // Размер в элемент�
 821:../ST7789/st7789.c ****     SendBuffer((uint16_t*)disp_buf, sizeof(disp_buf) / 2);      // Размер в 16-битных 
 822:../ST7789/st7789.c **** #else
 823:../ST7789/st7789.c **** 
 824:../ST7789/st7789.c ****     for (uint16_t i = 0; i < adjusted_height; i++) {
 825:../ST7789/st7789.c ****         uint8_t data[] = { color >> 8, color & 0xFF };
 826:../ST7789/st7789.c ****         ST7789_WriteData(data, sizeof(data));
 827:../ST7789/st7789.c ****     }
 828:../ST7789/st7789.c **** #endif
 829:../ST7789/st7789.c **** }
