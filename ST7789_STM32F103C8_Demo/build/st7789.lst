 952:../ST7789/st7789.c **** /** 
 953:../ST7789/st7789.c ****  * @brief Draw Fast a Filled circle with single color
 954:../ST7789/st7789.c ****  * @param x0&y0 -> coordinate of circle center
 955:../ST7789/st7789.c ****  * @param r -> radius of circle
 956:../ST7789/st7789.c ****  * @param color -> color of circle
 957:../ST7789/st7789.c ****  * @return  none
 958:../ST7789/st7789.c ****  */
 959:../ST7789/st7789.c **** void ST7789_DrawFastFilledCircle(int16_t x0, int16_t y0, int16_t r, uint16_t color) 
 960:../ST7789/st7789.c **** {
 961:../ST7789/st7789.c ****     ST7789_Select();
 962:../ST7789/st7789.c ****     int16_t f = 1 - r;
 963:../ST7789/st7789.c ****     int16_t ddF_x = 1;
 964:../ST7789/st7789.c ****     int16_t ddF_y = -2 * r;
 965:../ST7789/st7789.c ****     int16_t x = 0;
 966:../ST7789/st7789.c ****     int16_t y = r;
 967:../ST7789/st7789.c **** 
 968:../ST7789/st7789.c ****     ST7789_DrawFastHLine(x0 - r, y0, 2 * r + 1, color);
 969:../ST7789/st7789.c **** 
 970:../ST7789/st7789.c ****     while (x < y) {
 971:../ST7789/st7789.c ****         if (f >= 0) {
 972:../ST7789/st7789.c ****             y--;
 973:../ST7789/st7789.c ****             ddF_y += 2;
 974:../ST7789/st7789.c ****             f += ddF_y;
 975:../ST7789/st7789.c ****         }
 976:../ST7789/st7789.c ****         x++;
 977:../ST7789/st7789.c ****         ddF_x += 2;
 978:../ST7789/st7789.c ****         f += ddF_x;
 979:../ST7789/st7789.c **** 
 980:../ST7789/st7789.c ****         ST7789_DrawFastHLine(x0 - x, y0 + y, 2 * x + 1, color); 
 981:../ST7789/st7789.c ****         ST7789_DrawFastHLine(x0 - x, y0 - y, 2 * x + 1, color); 
 982:../ST7789/st7789.c **** 
 983:../ST7789/st7789.c ****         ST7789_DrawFastHLine(x0 - y, y0 + x, 2 * y + 1, color); 
 984:../ST7789/st7789.c ****         ST7789_DrawFastHLine(x0 - y, y0 - x, 2 * y + 1, color); 
 985:../ST7789/st7789.c ****     }
 986:../ST7789/st7789.c **** 
 987:../ST7789/st7789.c ****     ST7789_UnSelect();
 988:../ST7789/st7789.c **** }
