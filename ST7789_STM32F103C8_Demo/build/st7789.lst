 863:../ST7789/st7789.c ****  * @param color -> color of the Rectangle line
 864:../ST7789/st7789.c ****  * @return none
 865:../ST7789/st7789.c ****  */
 866:../ST7789/st7789.c **** void ST7789_DrawFastFilledRectangle(uint16_t x, uint16_t y, uint16_t w, uint16_t h, uint16_t color)
 867:../ST7789/st7789.c **** {
 868:../ST7789/st7789.c ****     /* Validate input */
 869:../ST7789/st7789.c ****     if (x >= ST7789_WIDTH || y >= ST7789_HEIGHT) {
 870:../ST7789/st7789.c ****         return; // Out of bounds, exit
 871:../ST7789/st7789.c ****     }
 872:../ST7789/st7789.c **** 
 873:../ST7789/st7789.c ****     /* Correct width and height if rectangle overflows */
 874:../ST7789/st7789.c ****     if ((x + w) > ST7789_WIDTH) {
 875:../ST7789/st7789.c ****         w = ST7789_WIDTH - x;
 876:../ST7789/st7789.c ****     }
 877:../ST7789/st7789.c ****     if ((y + h) > ST7789_HEIGHT) {
 878:../ST7789/st7789.c ****         h = ST7789_HEIGHT - y;
 879:../ST7789/st7789.c ****     }
 880:../ST7789/st7789.c **** 
 881:../ST7789/st7789.c ****     /* Set the window area */
 882:../ST7789/st7789.c ****     ST7789_SetAddressWindow(x, y, x + w - 1, y + h - 1);
 883:../ST7789/st7789.c ****     ST7789_Select();
 884:../ST7789/st7789.c **** 
 885:../ST7789/st7789.c **** 	#if ST7789_USE_DMA
 886:../ST7789/st7789.c ****     /* Fill the rectangle using DMA */
 887:../ST7789/st7789.c ****     uint32_t total_pixels = w * h;
ARM GAS  /tmp/ccvpQaby.s 			page 17


 888:../ST7789/st7789.c ****     uint32_t buffer_size = sizeof(disp_buf) / 2; // Buffer size in 16-bit pixels
 889:../ST7789/st7789.c **** 
 890:../ST7789/st7789.c ****     for (uint32_t i = 0; i < total_pixels / buffer_size; i++) {
 891:../ST7789/st7789.c ****         memset_16((uint16_t*)disp_buf, color, buffer_size); // Fill buffer with color
 892:../ST7789/st7789.c ****         SendBuffer((uint16_t*)disp_buf, buffer_size);       // Send filled buffer
 893:../ST7789/st7789.c ****     }
 894:../ST7789/st7789.c **** 
 895:../ST7789/st7789.c ****     /* Handle the remainder if total_pixels is not a multiple of buffer_size */
 896:../ST7789/st7789.c ****     uint32_t remaining_pixels = total_pixels % buffer_size;
 897:../ST7789/st7789.c ****     if (remaining_pixels > 0) {
 898:../ST7789/st7789.c ****         memset_16((uint16_t*)disp_buf, color, remaining_pixels);
 899:../ST7789/st7789.c ****         SendBuffer((uint16_t*)disp_buf, remaining_pixels);
 900:../ST7789/st7789.c ****     }
 901:../ST7789/st7789.c **** 
 902:../ST7789/st7789.c ****     #else
 903:../ST7789/st7789.c ****     /* CPU-based rectangle filling */
 904:../ST7789/st7789.c ****     for (uint16_t i = 0; i < h; i++) {
 905:../ST7789/st7789.c ****         for (uint16_t j = 0; j < w; j++) {
 906:../ST7789/st7789.c ****             uint8_t data[] = {color >> 8, color & 0xFF};
 907:../ST7789/st7789.c ****             ST7789_WriteData(data, sizeof(data));
