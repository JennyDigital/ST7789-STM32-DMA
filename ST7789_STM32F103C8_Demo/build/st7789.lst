  33:../ST7789/st7789.c **** 
  34:../ST7789/st7789.c **** /**
  35:../ST7789/st7789.c ****  * @brief Write command to ST7789 controller
  36:../ST7789/st7789.c ****  * @param cmd -> command to write
  37:../ST7789/st7789.c ****  * @return none
  38:../ST7789/st7789.c ****  */
  39:../ST7789/st7789.c **** static void ST7789_WriteCommand(uint8_t cmd)
  40:../ST7789/st7789.c **** {
  41:../ST7789/st7789.c **** 	ST7789_Select();
  42:../ST7789/st7789.c **** 	ST7789_DC_Clr();
  43:../ST7789/st7789.c **** 	ST7789_SPI_WRITE(&cmd, sizeof(cmd));
  44:../ST7789/st7789.c **** 	ST7789_UnSelect();
  45:../ST7789/st7789.c **** }
  46:../ST7789/st7789.c **** 
  47:../ST7789/st7789.c **** /**
  48:../ST7789/st7789.c ****  * @brief Write data to ST7789 controller
  49:../ST7789/st7789.c ****  * @param buff -> pointer of data buffer
  50:../ST7789/st7789.c ****  * @param buff_size -> size of the data buffer
  51:../ST7789/st7789.c ****  * @return none
  52:../ST7789/st7789.c ****  */
  53:../ST7789/st7789.c **** static void ST7789_WriteData(uint8_t *buff, size_t buff_size)
  54:../ST7789/st7789.c **** {
  55:../ST7789/st7789.c **** 	ST7789_Select();
  56:../ST7789/st7789.c **** 	ST7789_DC_Set();
  57:../ST7789/st7789.c **** 
  58:../ST7789/st7789.c **** 	// split data in small chunks because HAL can't send more than 64K at once
  59:../ST7789/st7789.c **** 
  60:../ST7789/st7789.c **** 	while (buff_size > 0) {
  61:../ST7789/st7789.c **** 		uint16_t chunk_size = buff_size > 65534 ? 65534 : buff_size;
  62:../ST7789/st7789.c **** 		#if ST7789_USE_DMA
  63:../ST7789/st7789.c **** 			if (DMA_MIN_SIZE <= buff_size)
  64:../ST7789/st7789.c **** 			{
  65:../ST7789/st7789.c **** 				ST7789_SPI_WRITE_DMA(buff, chunk_size);
  66:../ST7789/st7789.c **** 				ST7789_SPI_WAIT_DMA();
  67:../ST7789/st7789.c **** 			}
  68:../ST7789/st7789.c **** 			else
  69:../ST7789/st7789.c **** 				ST7789_SPI_WRITE(buff, chunk_size);
  70:../ST7789/st7789.c **** 		#else
  71:../ST7789/st7789.c **** 			ST7789_SPI_WRITE(buff, chunk_size);
  72:../ST7789/st7789.c **** 		#endif
  73:../ST7789/st7789.c **** 		buff += chunk_size;
  74:../ST7789/st7789.c **** 		buff_size -= chunk_size;
  75:../ST7789/st7789.c **** 	}
  76:../ST7789/st7789.c **** 
  77:../ST7789/st7789.c **** 	ST7789_UnSelect();
  78:../ST7789/st7789.c **** }
  79:../ST7789/st7789.c **** 
  80:../ST7789/st7789.c **** void SendBuffer(uint16_t *disp_buf, size_t size) 
  81:../ST7789/st7789.c **** {
  82:../ST7789/st7789.c ****     // Convert 16-bit data into a byte sequence
  83:../ST7789/st7789.c ****     uint8_t *byte_ptr = (uint8_t *)disp_buf; // Cast the pointer to 8-bit
  84:../ST7789/st7789.c **** 
  85:../ST7789/st7789.c ****     // Send data as it is
  86:../ST7789/st7789.c ****     ST7789_WriteData(byte_ptr, size * 2); // Transmit data, size multiplied by 2
  87:../ST7789/st7789.c **** }
  88:../ST7789/st7789.c **** 
  89:../ST7789/st7789.c **** /**
ARM GAS  /tmp/ccvpQaby.s 			page 3


  90:../ST7789/st7789.c ****  * @brief Write data to ST7789 controller, simplify for 8bit data.
  91:../ST7789/st7789.c ****  * data -> data to write
  92:../ST7789/st7789.c ****  * @return none
  93:../ST7789/st7789.c ****  */
  94:../ST7789/st7789.c **** static void ST7789_WriteSmallData(uint8_t data)
  95:../ST7789/st7789.c **** {
  96:../ST7789/st7789.c **** 	ST7789_Select();
  97:../ST7789/st7789.c **** 	ST7789_DC_Set();
  98:../ST7789/st7789.c **** 	ST7789_SPI_WRITE(&data, sizeof(data));
  99:../ST7789/st7789.c **** 	ST7789_UnSelect();
 100:../ST7789/st7789.c **** }
