 419:../ST7789/st7789.c **** 		ST7789_DrawPixel(x0 + x, y0 + y, color);
 420:../ST7789/st7789.c **** 		ST7789_DrawPixel(x0 - x, y0 + y, color);
 421:../ST7789/st7789.c **** 		ST7789_DrawPixel(x0 + x, y0 - y, color);
 422:../ST7789/st7789.c **** 		ST7789_DrawPixel(x0 - x, y0 - y, color);
 423:../ST7789/st7789.c **** 
 424:../ST7789/st7789.c **** 		ST7789_DrawPixel(x0 + y, y0 + x, color);
 425:../ST7789/st7789.c **** 		ST7789_DrawPixel(x0 - y, y0 + x, color);
 426:../ST7789/st7789.c **** 		ST7789_DrawPixel(x0 + y, y0 - x, color);
 427:../ST7789/st7789.c **** 		ST7789_DrawPixel(x0 - y, y0 - x, color);
 428:../ST7789/st7789.c **** 	}
