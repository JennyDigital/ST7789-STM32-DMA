 918:../ST7789/st7789.c **** {
 919:../ST7789/st7789.c ****     // Sort the vertices by their y-coordinates (y1 <= y2 <= y3)
 920:../ST7789/st7789.c ****     if (y1 > y2) { SWAP(x1, x2); SWAP(y1, y2); }
 921:../ST7789/st7789.c ****     if (y2 > y3) { SWAP(x2, x3); SWAP(y2, y3); }
 922:../ST7789/st7789.c ****     if (y1 > y2) { SWAP(x1, x2); SWAP(y1, y2); }
 923:../ST7789/st7789.c **** 
 924:../ST7789/st7789.c ****     ST7789_Select();
 925:../ST7789/st7789.c **** 
 926:../ST7789/st7789.c ****     uint16_t total_height = y3 - y1;
 927:../ST7789/st7789.c **** 
 928:../ST7789/st7789.c ****     // Iterate over the vertical range of the triangle
 929:../ST7789/st7789.c ****     for (uint16_t y = y1; y <= y3; y++) {
 930:../ST7789/st7789.c ****         // Check whether the current scanline belongs to the lower or upper segment of the triangle
 931:../ST7789/st7789.c ****         bool is_lower = y > y2 || y2 == y1;
 932:../ST7789/st7789.c ****         uint16_t segment_height = is_lower ? (y3 - y2) : (y2 - y1);
 933:../ST7789/st7789.c **** 
 934:../ST7789/st7789.c ****         // Compute the horizontal interpolation progress for the edges
 935:../ST7789/st7789.c ****         float alpha = (float)(y - y1) / total_height; // Progress along the entire height
 936:../ST7789/st7789.c ****         float beta = (float)(y - (is_lower ? y2 : y1)) / segment_height; // Progress within the seg
 937:../ST7789/st7789.c **** 
 938:../ST7789/st7789.c ****         // Calculate the horizontal boundaries for the current scanline
 939:../ST7789/st7789.c ****         int16_t A = x1 + (x3 - x1) * alpha;
 940:../ST7789/st7789.c ****         int16_t B = is_lower ? x2 + (x3 - x2) * beta : x1 + (x2 - x1) * beta;
 941:../ST7789/st7789.c **** 
 942:../ST7789/st7789.c ****         // Ensure A is to the left of B
 943:../ST7789/st7789.c ****         if (A > B) SWAP(A, B);
 944:../ST7789/st7789.c **** 
